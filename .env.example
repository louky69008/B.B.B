# Supabase — valeurs disponibles dans le tableau de bord du projet.
# Copier ce fichier vers `.env`; ne jamais commiter `.env`.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Serveur uniquement. Utiliser la clé secrète du MÊME projet que SUPABASE_URL.
# Les nouvelles clés ont le préfixe sb_secret_; la clé legacy est service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif. Lien de paiement web RevenueCat et identifiants des offres publiées.
VITE_REVENUECAT_WEB_PURCHASE_LINK=
VITE_REVENUECAT_PACKAGE_BASIC_LITE=
VITE_REVENUECAT_PACKAGE_MONTHLY=
VITE_REVENUECAT_PACKAGE_PREMIUM=
VITE_REVENUECAT_PACKAGE_ULTRA=
VITE_REVENUECAT_PACKAGE_DAY_PASS=

# Serveur uniquement. Secret du webhook. Sandbox uniquement sur une base de test.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ALLOW_SANDBOX=false
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
