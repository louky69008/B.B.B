# ─────────────────────────────────────────────────────────────
# Supabase — copier ce fichier en `.env` et compléter les valeurs.
# Récupérez-les dans Supabase > Project Settings > API Keys.
# ⚠️ Ne commit JAMAIS le fichier .env (il est ignoré par Git).
# ─────────────────────────────────────────────────────────────

# URL du projet (ex: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=

# Clé publiable / anon — sûre pour le navigateur, protégée par les RLS
VITE_SUPABASE_PUBLISHABLE_KEY=

# Reprises sans le préfixe VITE_ pour le code serveur
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Identifiant du projet (utilisé par certains outils Lovable)
VITE_SUPABASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────
# Clé service_role — UNIQUEMENT côté serveur.
# ⚠️ SECRET ABSOLU : contourne toutes les RLS. Ne jamais l'exposer
# au navigateur, ne jamais la commiter, ne jamais la partager.
# Indispensable pour : les migrations CLI, la modération, la purge
# de compte, les statistiques publiques.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Optionnel — abonnements mobiles
# ─────────────────────────────────────────────────────────────
# VITE_REVENUECAT_IOS_KEY=
# VITE_REVENUECAT_ANDROID_KEY=
